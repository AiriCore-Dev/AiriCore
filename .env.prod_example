# Base
HOST = 0.0.0.0                         # 监听地址
PORT = 15100                           # 监听端口
enable_ssl = false                     # 是否启用 Bot 与营销服务的 SSL（默认关闭）
LOG_LEVEL = SUCCESS                    # 日志级别（DEBUG/INFO/SUCCESS/WARNING/ERROR）
DRIVER = ~fastapi+~httpx               # 驱动器
FASTAPI_RELOAD = false                 # 是否启用热重载（生产环境建议 false）
COMMAND_START = ["","/"]               # 命令前缀
COMMAND_SEP = ["."]                    # 命令分隔符
ONEBOT_ACCESS_TOKEN = ""               # OneBot 连接鉴权 Token，需与 NapCat 等客户端一致
LOCALSTORE_USE_CWD = True              # 本地存储是否使用当前工作目录
SUPERUSERS = []                        # 超级用户 QQ 号列表，拥有最高权限
nickname = [""]                        # Bot 昵称列表，用于触发响应

# jrlp
TODAY_WAIFU_ALIASES = ["今日老婆","jrlp","娶老婆","娶群友","抽群老婆"]  # 今日老婆命令别名

# chess
cchess_engine_path = './utils/pyfairy_xiangqi.py'  # 象棋引擎脚本路径

# htmlrender
htmlrender_browser = ""                # 渲染浏览器内核（firefox/webkit，留空使用默认 Chromium；填 chromium 会触发上游插件的误报警告）

# status
status_nickname = ""                   # 状态插件显示的 Bot 昵称（留空则使用 nickname）
status_cpu_cores = ""                  # CPU 核心数（用于状态展示，留空自动检测）
status_cpu_model = ""                  # CPU 型号（用于状态展示，留空自动检测）
status_os_info = ""                    # 操作系统信息（用于状态展示，留空自动检测）
status_fallback_fonts = ""             # 状态图片备用字体路径（留空使用系统默认）

# airi_LLM
airi_llm_whitelist_bot = []            # 允许使用 LLM 功能的 Bot QQ 号列表（留空则所有 Bot 可用）
airi_llm_blacklist_group = []          # 禁止 LLM 聊天的群号列表（黑名单群内不记录上下文也不发言，留空则不屏蔽）
airi_char_name = ""                    # Bot 角色名（人设名称）
airi_char_aliases = []                 # Bot 角色名别名列表（用于@识别等）
airi_char_alias_excludes = []          # 别名误命中排除词（如 ["爱莉希雅"]）

# MCRcon
rcon_password = ""                     # Minecraft RCON 连接密码（无 MC 服务器可留空）
rcon_host = "127.0.0.1"                # Minecraft RCON 主机地址
rcon_port = 25575                      # Minecraft RCON 端口
mc_server_path = ""                    # Minecraft 服务端根目录（留空使用默认 /root/airi/airicob5）
mc_whitelist_groups = []               # 允许使用 / 开头服管指令的群号列表（留空使用内置默认）
mc_alert_group = ""                    # 服务器高温告警推送群号（留空取白名单第一个）

# market
market_domain = ""                     # 营销邮件退订服务的公网域名（必填，如需使用 airi_market 插件）
market_port = 22320                    # 营销邮件退订服务监听端口
market_invite_new_bots = false         # 新 Bot 首次连接时是否自动向 {botQQ}@qq.com 发送入群邀请邮件
market_bind_host = ""                  # 营销退订服务监听地址（留空使用 127.0.0.1）
market_daily_limit = 3000              # 每日最大发送邮件数量
market_send_start_hour = 8             # 每日开始发送邮件的小时（24小时制）
market_send_end_hour = 21              # 每日停止发送邮件的小时（24小时制）

# E-mail
email_smtp_host = ""                   # SMTP 服务器地址（必填，如需使用邮件功能）
email_smtp_user = ""                   # SMTP 登录用户名（通常为发件邮箱，必填）
email_smtp_password = ""               # SMTP 登录密码（必填）
email_from_name = "AiriCore Service"   # 发件人显示名称
email_from_address = ""                # 发件人邮箱地址（必填）

# Curfew
curfew_bot_ids = []                    # 受宵禁限制的 Bot QQ 号列表（23:00-6:00 静默，留空则无宵禁）
curfew_plugin_whitelist = ["airi_switch"]  # 宵禁期间仍允许运行的插件白名单

# Unified_Password
_2fa_key = ""                          # 二步验证 TOTP 密钥（Base32 格式，留空则不启用 2FA）

# Switch
notification_account = ""              # 接收系统通知的 QQ 号（留空则不发送通知）
notification_bot_account = ""           # 发送系统通知的 Bot QQ 号（留空使用当前在线的第一个 Bot）
airifullgroup_bot_whitelist = []       # 允许执行全群广播的 Bot QQ 号列表（留空则禁止广播）
reboot_screen_session = "airicore"     # reboot / force-reboot 指令操作的 screen 会话名
reboot_workdir = ""                    # reboot 重启时的工作目录（留空取当前进程工作目录）
cache_mode = balanced                  # 缓存模式（ram 全内存 / balanced 内存+磁盘均衡 / disk 省内存，默认 balanced）
cache_preload_budget_mb = 4096         # ram 模式启动预热的内存上限（MB，仅 ram 模式生效）

# General
airicore_version = "AiriCore v26.8 Oeschinen"  # 当前版本号（用于展示）
